# Candidate (A): 4x4 arch with a 64-bit output stream so the aux xbar output
# width (64) equals AXI_OSTREAM_DATA_WIDTH and no width adaptation occurs.
# ResNet-8 classification architecture without the final Softmax primitive.
# Argmax(logits) is identical to argmax(softmax(logits)); exposing logits also
# avoids spending FPGA resources on a post-processing block that is not needed
# by the MLPerf Tiny image-classification decision.

family : 'AGX3'
k_vector : 8
c_vector : 8
arch_precision : FP12AGX

stream_buffer_depth : 12288

enable_on_chip_parameters : true
disable_external_memory : true

output_channels_max : 16384

enable_eltwise_mult : true
filter_size_width_max : 28
filter_size_height_max : 28

input_stream_interface {
  enable : true
  data_width : 96
}

output_stream_interface {
  enable : true
  data_width : 64
  fifo_depth : 32
}

lightweight_layout_transform_params {
  channels : 3
  input_bus_width : 96
  input_type : F16
  enable_bias_scale : false
}

pe_array {
  num_interleaved_features : 12
  num_interleaved_filters : 1
  exit_fifo_depth : 128
  enable_scale : true
}

filter_scratchpad {
  filter_depth : 1300
  bias_scale_depth : 80
}

dma {
  csr_addr_width : 11
  csr_data_bytes : 4
  ddr_addr_width : 32
  ddr_burst_width : 4
  ddr_data_bytes : 32
  ddr_read_id_width : 2
  ddr_write_id_width : 5
}

config_network {
  config_cache_depth : 2433
}

activation {
  k_vector : 8
  enable_clamp : false
  enable_round_clamp : true
  enable_leaky_relu : false
  enable_sigmoid : false
  enable_prelu : false
}

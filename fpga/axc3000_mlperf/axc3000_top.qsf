set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name BOARD default
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL
set_global_assignment -name VERILOG_FILE sources/axc3000_top.v
set_global_assignment -name QSYS_FILE NIOSV_lab.qsys

# Arrow AXC3000 pin assignments (from sources/axc3000_pin_assignment.tcl).
set_location_assignment PIN_A7  -to CLK_25M_C
set_instance_assignment -name IO_STANDARD "1.3-V LVCMOS" -to CLK_25M_C
